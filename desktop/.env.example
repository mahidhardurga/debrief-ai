# Copy to .env and edit. Real environment variables override this file.
# Models and timing
LIVE_MODEL=sonnet
FINAL_MODEL=opus
CORRECT_MODEL=sonnet
EXHIBIT_MODEL=sonnet
CHAT_MODEL=sonnet
FILL_MODEL=sonnet
CLI_TIMEOUT=240
# GitHub Copilot is the other AI you can pick (top bar, "AI: ..."): npm install -g @github/copilot, then run `copilot login`
COPILOT_CLI_PATH=copilot
COPILOT_MODEL=auto
ANALYZE_INTERVAL=60
ANALYZE_MIN_GAP=30
ANALYZE_NEW_LINES=4
# Speech (models download once; then run offline)
WHISPER_MODEL=small.en
DRAFT_WHISPER_MODEL=base.en
FINAL_WHISPER_MODEL=distil-large-v3
ACCURATE_MAX_DECODE=6
SPEAKER_DEVICE=
# 1 = download missing speech models into desktop\models on first run (they stay in the project); 0 = never go online
ALLOW_MODEL_DOWNLOAD=1
# Screen watching
# interval = a screenshot is kept every N seconds (the interval you pick) when something new is on screen; settled = only after the screen changed and stood still
WATCH_MODE=interval
# 0 = every watched screenshot stays; 1 = the AI deletes frames it judges unrelated to the call
WATCH_DROP_IRRELEVANT=0
WATCH_STABLE=2
WATCH_CHANGE=0.02
WATCH_FORCE=90
# Recording (default folder is outside OneDrive and the project)
# RECORDINGS_DIR=C:\Users\you\AppData\Local\DebriefAI\recordings
RECORD_AUDIO=1
VIDEO_RECORD=1
REQUIRE_CONSENT=1
RECORDING_RETENTION_DAYS=30
MIN_FREE_MB=500
VIDEO_FPS=5
VIDEO_MAX_WIDTH=1280
VIDEO_CRF=30
# App
PORT=5057
SESSIONS_DIR=sessions
MOCK_ANALYZER=0
# Form filling
FORM_URL=
FORM_MODE=window
FORM_BROWSER=msedge
# FORM_PROFILE_DIR=C:\Users\you\AppData\Local\DebriefAI\formprofile
FILL_TIMEOUT=900

# --- telling the people on a call apart (Speaker 1, 2, 3...) ---
# The start screen offers it; this sets whether it is ticked by default. The 26 MB voice model is downloaded once
# to desktop\models (with the speech models), or set SPEAKER_MODEL to another file.
SPEAKERS_DEFAULT=1
# SPEAKER_MODEL=
# Similarity above which two voices count as the same person (higher splits people more often).
SPEAKER_THRESHOLD=0.62
