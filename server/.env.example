# Copy to .env and edit. Keep comments on their own lines: Docker Compose treats text after "=" as part of the value.

# --- required ---
POSTGRES_PASSWORD=change-me
# 32+ random characters; ENV=prod refuses to start without it (python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=generate-with-openssl-rand-hex-32

# --- optional: key for the stored Claude tokens ---
# Leave empty to derive it from SECRET_KEY. Or set a Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Keep it stable and back it up: changing it makes every user reconnect Claude.
ENCRYPTION_KEY=

# --- accounts ---
# The first account is always allowed and becomes the administrator. Set false afterwards to close sign-up.
ALLOW_REGISTRATION=true

# --- LLM ---
# cli (Claude Code CLI), anthropic (one server API key), mock (demo/tests)
LLM_PROVIDER=cli
# per_user: every user connects their OWN Claude login in the app (stored encrypted).
# shared: one login stored on the server for everybody (small teams only).
CLAUDE_AUTH=per_user
LIVE_MODEL=sonnet
FINAL_MODEL=opus
# The other model users can pick instead of Claude: GitHub Copilot (each user pastes their own GitHub token)
COPILOT_CLI_PATH=copilot
# auto lets Copilot choose; or name a model that your users' plans have
COPILOT_MODEL=auto
# Parallel claude/copilot processes on the whole server, and per user.
LLM_CONCURRENCY=4
LLM_USER_CONCURRENCY=2
# Only for LLM_PROVIDER=anthropic:
# ANTHROPIC_API_KEY=sk-ant-...

# --- screen watching: interval = a frame every N seconds when something new is on screen; settled = only after it stood still
WATCH_MODE=interval
# true: the AI deletes watched frames it judges unrelated to the call; false: everything watched is kept
WATCH_DROP_IRRELEVANT=false

# --- speech (server-side Whisper): models are downloaded once, then run offline ---
ASR_MODEL=small.en
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
# Set false after the first model download.
ASR_ALLOW_DOWNLOAD=true
# Optional: a second, more accurate pass that quietly replaces a line's text a few seconds later (like the desktop app).
# Needs a lot more CPU and a larger download (distil-large-v3 is about 1.5 GB); leave empty to turn it off.
ASR_REFINE_MODEL=

CORS_ORIGINS=http://localhost:8000
